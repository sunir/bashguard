#!/usr/bin/env python3
"""
Plugin: identity-inventory (SessionStart)
Story: memory-smarten-colony

WHY: Agents forget what they've built. cli once denied its own `colony msg` wrapper
     existed — it was on page 1 of --help. Agents forget their taken todos across
     fresh (non-compact) sessions. They forget what they were doing last session.
     This hook surfaces all three: what you own, what you're doing, what you did.

OUTPUTS (to stderr — injected into Claude's initial context):
  1. Identity block — bin/ tools, recent commits, current taken todos

FAIL-OPEN: exits 0 always, never blocks session start.
BASH: uses python3 (macOS compat)
"""

import json
import os
import subprocess
import sys

INPUT = sys.stdin.read()

# ── locate repo root ──────────────────────────────────────────────────────────
# Hook lives at: .claude/hooks/SessionStart.d/system/30-identity-inventory
# Go up 4 levels: system/ → SessionStart.d/ → hooks/ → .claude/ → repo
HOOK_DIR = os.path.dirname(os.path.abspath(__file__))
REPO_ROOT = os.path.abspath(os.path.join(HOOK_DIR, '..', '..', '..', '..'))

# Only fire for colony repos (presence of .colony file)
if not os.path.exists(os.path.join(REPO_ROOT, '.colony')):
    sys.exit(0)

REPO_NAME = os.path.basename(REPO_ROOT)

# ── gather: bin/ tools ────────────────────────────────────────────────────────
bin_dir = os.path.join(REPO_ROOT, 'bin')
tools = []
if os.path.isdir(bin_dir):
    for name in sorted(os.listdir(bin_dir)):
        path = os.path.join(bin_dir, name)
        if os.path.isfile(path) and os.access(path, os.X_OK):
            tools.append(name)

# ── gather: specs count ───────────────────────────────────────────────────────
specs_count = 0
specs_dir = os.path.join(REPO_ROOT, 'specs')
if os.path.isdir(specs_dir):
    for root, dirs, files in os.walk(specs_dir):
        specs_count += sum(1 for f in files if f.endswith('.md'))

# ── gather: recent git commits ────────────────────────────────────────────────
recent_commits = []
try:
    result = subprocess.run(
        ['git', 'log', '--oneline', '-10', '--no-merges'],
        capture_output=True, text=True, timeout=5, cwd=REPO_ROOT
    )
    if result.returncode == 0:
        recent_commits = [l.strip() for l in result.stdout.strip().splitlines() if l.strip()]
except Exception:
    pass

# ── gather: taken todos ───────────────────────────────────────────────────────
taken_todos = []
todo_path = os.path.join(REPO_ROOT, '.todo.json')
if os.path.exists(todo_path):
    try:
        with open(todo_path) as f:
            data = json.load(f)
        for item in data.get('todos', []):
            if item.get('status') == 'taken':
                taken_todos.append(f"  %{item.get('id', '?')} {item.get('content', '')[:80]}")
    except Exception:
        pass

# ── build output ──────────────────────────────────────────────────────────────

lines = [f"=== {REPO_NAME.upper()} IDENTITY INVENTORY ==="]

if tools:
    lines.append(f"\nYour tools in bin/ ({len(tools)} total):")
    for t in tools:
        lines.append(f"  {t}")
else:
    lines.append("\nNo tools in bin/ yet.")

if specs_count:
    lines.append(f"\n{specs_count} spec(s) in specs/")

if recent_commits:
    lines.append("\nYour recent commits:")
    for c in recent_commits[:8]:
        lines.append(f"  {c}")

if taken_todos:
    lines.append("\nCurrently taken todos (in progress):")
    for t in taken_todos:
        lines.append(t)
else:
    lines.append("\nNo todos currently taken.")

lines.append("\nTip: `rag search 'task'` in heuristics/ before starting unfamiliar work.")
lines.append(f"=== END IDENTITY INVENTORY ===")

print('\n'.join(lines), file=sys.stderr)
sys.exit(0)
