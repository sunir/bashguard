#!/usr/bin/env python3
# Plugin: pm-notify (Stop)
# Story: PM-NOTIFY-FAILOPEN
"""Notify pm-drain when a repo goes waiting_user or blocked.

Runs after 25-status-yaml. If the new status is blocking, touches
/tmp/colony-work-pending so the watchdog drains immediately.

LOAD-BEARING: this is a notify side effect, not a blocking check. It must
NEVER hard-fail the Stop hook. The trigger file is shared across every
colony uid (501/502/codex/etc); whichever uid creates it first owns it, and
Path.touch() on an EXISTING file still needs write access to bump its mtime
-- so a different uid touching it raises PermissionError (a subclass of
OSError). All trigger I/O here is therefore fail-open: any OSError is
swallowed and we always reach sys.exit(0). After a successful touch we also
chmod the trigger world-writable so every other colony uid can re-touch it
on future runs (closes the root cause, not just today's crash) -- that chmod
is fail-open too, since we may not own the file and thus can't chmod it.
"""
import os
import sys
from pathlib import Path

REPO = Path(os.environ.get("REPO_ROOT", "."))
STATUS = REPO / ".status.yaml"
TRIGGER = Path(os.environ.get("PM_NOTIFY_TRIGGER", "/tmp/colony-work-pending"))


# ── pure logic (unit-tested) ──────────────────────────────────────────────────

def is_blocking(content: str) -> bool:
    """True if .status.yaml content indicates the repo needs pm-drain attention."""
    return "waiting_user" in content or ("blocked" in content and "blockers:" in content)


# ── I/O (fail-open) ────────────────────────────────────────────────────────────

def notify(trigger: Path) -> None:
    """Touch the trigger file and make it world-writable for future cross-uid
    touches. Never raises: a notify side effect must never fail the Stop hook."""
    try:
        trigger.touch()
        os.chmod(trigger, 0o666)
    except OSError:
        pass


def main() -> int:
    if STATUS.exists():
        content = STATUS.read_text()
        if is_blocking(content):
            notify(TRIGGER)
    return 0


if __name__ == "__main__":
    sys.exit(main())
